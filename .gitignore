# ---- 密钥与运行数据（红线，永不入库）----
# NOTE: these are ROOT-ONLY paths. The leading "/" is load-bearing: without it,
# "step/" also matched viewer/packages/cadjs/src/lib/step/, so two real source
# files (stepTree.js, stepModule.js) were silently excluded from the repo and
# the frontend build failed on a clean checkout with:
#     Could not load .../cadjs/src/lib/step/stepTree
# Any new entry here that names a directory must keep the leading "/".
/secrets/
/logs/
/uploads/
/__cadgen__/
/samples/
/step/
/docs/

# ---- 机器专属配置（模板 local.env.cmd.example 入库，实际配置不入库）----
tools/local.env.cmd

# ---- 构建产物 ----
node_modules/
dist/
build/

# ---- Python ----
__pycache__/
*.pyc
.venv/
*.egg-info/

# ---- 杂项 ----
*.log
.DS_Store
Thumbs.db
.workbuddy/
